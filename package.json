{
  "name": "algotron",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "scripts": {
    "dev": "bun --hot backend/src/server.ts",
    "start": "NODE_ENV=production bun backend/src/server.ts",
    "build": "bun build backend/src/server.ts --target=bun --production --outdir=dist",
